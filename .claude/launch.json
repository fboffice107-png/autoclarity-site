{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ppi-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "pages", "dev", ".", "--port", "8788"],
      "port": 8788
    },
    {
      "name": "ppi-attach",
      "url": "http://localhost:8788",
      "port": 8788
    },
    {
      "comment": "Payment-flow UI verification: preview mode with payments ON, pointed at a LOCAL mock Stripe (scripts never touch stripe.com). Start the mock first.",
      "name": "ppi-payments-ui",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler", "pages", "dev", ".", "--port", "8791",
        "--binding", "ADMIN_DEV_KEY=test-admin-key-0123456789abcdef",
        "--binding", "PPI_ENV=preview",
        "--binding", "PPI_MODE=request",
        "--binding", "PAYMENTS_ENABLED=true",
        "--binding", "STRIPE_ENV=test",
        "--binding", "STRIPE_SECRET_KEY=sk_test_local_ui_mock",
        "--binding", "STRIPE_WEBHOOK_SECRET=whsec_local_ui_mock",
        "--binding", "STRIPE_API_BASE=http://127.0.0.1:8798/v1",
        "--binding", "UPLOADS_ENABLED=true",
        "--binding", "PUBLIC_BASE_URL=http://localhost:8791",
        "--binding", "TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA",
        "--r2", "UPLOADS"
      ],
      "port": 8791
    },
    {
      "name": "ppi-ui-test",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler", "pages", "dev", ".", "--port", "8790",
        "--binding", "ADMIN_DEV_KEY=test-admin-key-0123456789abcdef",
        "--binding", "PPI_ENV=preview",
        "--binding", "UPLOADS_ENABLED=true",
        "--binding", "PUBLIC_BASE_URL=http://localhost:8790",
        "--binding", "TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA",
        "--r2", "UPLOADS"
      ],
      "port": 8790
    }
  ]
}
